<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for TileStore (website addresses, names, glyphs, colours, ids): dotnet run (in this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Htpc.Launcher</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Launcher\TileStore.cs" />
  </ItemGroup>
</Project>
