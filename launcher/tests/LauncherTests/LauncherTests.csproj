<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks for the button maps, PadMapper, the video-end detector, the sleep timer, the logos, the
       decode-check parser and the alerts overlay: dotnet run (in this folder). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Htpc.Launcher</RootNamespace>
    <NoWarn>$(NoWarn);CS8321;WFO1000</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Src>..\..\src\Launcher\</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Src)ButtonMap.cs;$(Src)ButtonMapStore.cs;$(Src)PadMapper.cs;$(Src)MediaWatcher.cs;$(Src)SleepTimer.cs;$(Src)DecodeCheck.cs;$(Src)SetupRunner.cs;$(Src)Standby.cs;$(Src)ControllerService.cs;$(Src)SystemControls.cs;$(Src)AudioOutputs.cs;$(Src)SoundSwitch.cs;$(Src)Native.cs;$(Src)Tv\TvModel.cs;$(Src)AlertsForm.cs;$(Src)VolumeOsd.cs;$(Src)TileStore.cs;$(Src)PhonePointer.cs;$(Src)LogoSources.cs;$(Src)AppLogos.cs;$(Src)EdgeSiteApp.cs;$(Src)ScreenCapture.cs" />
  </ItemGroup>
</Project>
