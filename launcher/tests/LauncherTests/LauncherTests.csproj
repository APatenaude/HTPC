<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher's checks, one group per area (Program.cs lists them, Harness.cs runs them):
       dotnet run -c Release (in this folder); -v prints every check. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Htpc.Launcher</RootNamespace>
    <NoWarn>$(NoWarn);CS8321;WFO1000</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Src>..\..\src\Launcher\</Src>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Src)ButtonMap.cs;$(Src)ButtonMapStore.cs;$(Src)PadMapper.cs;$(Src)MediaWatcher.cs;$(Src)SleepTimer.cs;$(Src)DecodeCheck.cs;$(Src)SetupRunner.cs;$(Src)Standby.cs;$(Src)ControllerService.cs;$(Src)SystemControls.cs;$(Src)AudioOutputs.cs;$(Src)SoundSwitch.cs;$(Src)Native.cs;$(Src)Tv\TvModel.cs;$(Src)AlertsForm.cs;$(Src)VolumeOsd.cs;$(Src)TileStore.cs;$(Src)PhonePointer.cs;$(Src)LogoSources.cs;$(Src)AppLogos.cs;$(Src)EdgeSiteApp.cs;$(Src)ScreenCapture.cs;$(Src)AutostartGuard.cs;$(Src)AppManager.cs;$(Src)Shell.cs;$(Src)DesktopTray.cs;$(Src)AppExits.cs;$(Src)SetupElevation.cs;$(Src)SetupInstance.cs;$(Src)TextFieldWatcher.cs;$(Src)WebViewRecovery.cs;$(Src)LauncherOrigin.cs;$(Src)SoakLog.cs;$(Src)UpdateRules.cs;$(Src)Rights.cs;$(Src)WindowlessQuit.cs;$(Src)StartMenuScanner.cs;$(Src)ResourceRules.cs;$(Src)ResourceWatch.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Bluetooth radio's rule (off while nothing is paired, awake too). -->
    <Compile Include="$(Src)BluetoothRadio.cs" />
  </ItemGroup>
</Project>
