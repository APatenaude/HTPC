<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks of the launcher's logic that needs no screen, no controller and no network:
       the launcher's own source files, compiled with fakes around them.
       dotnet run -project launcher\dev\Checks  (exit code 0 = all passed) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Htpc.Launcher</RootNamespace>
    <AssemblyName>LauncherChecks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Launcher\Alerts.cs" Link="Launcher\Alerts.cs" />
    <Compile Include="..\..\src\Launcher\AppExits.cs" Link="Launcher\AppExits.cs" />
    <Compile Include="..\..\src\Launcher\InternetWatch.cs" Link="Launcher\InternetWatch.cs" />
  </ItemGroup>

</Project>
