<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version brings the WinRT APIs (media sessions for standby). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ScreenCapture.cs: Desktop Duplication through COM by hand, and its pixels. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- launcher\art\icon*.svg, built by launcher\dev\Build-Icon.ps1. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>HtpcLauncher</AssemblyName>
    <RootNamespace>Htpc.Launcher</RootNamespace>
    <!-- The version is in Directory.Build.props (one number for the whole release). -->
    <!-- Published for win-x64 only: named here so the lock file covers that restore too. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- NuGet packages pinned for the published build (Release: what Publish-Setup makes; the
         release restores in locked mode). Its own file name: NuGet updates any packages.lock.json
         it finds, and a Debug build (publishing self-contained adds a package it does not) would
         keep rewriting it. -->
    <!-- Only in locked mode (Publish-Setup -Locked, the release) or when renewing it (-p:Relock=true
         with a Release publish): a plain Release build would rewrite it without the publish-only
         package. -->
    <RestorePackagesWithLockFile Condition="'$(Configuration)' == 'Release' and ('$(RestoreLockedMode)' == 'true' or '$(Relock)' == 'true')">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(Configuration)' == 'Release' and ('$(RestoreLockedMode)' == 'true' or '$(Relock)' == 'true')">packages.release.lock.json</NuGetLockFilePath>
    <!-- The WebView2 package also carries its WPF control, whose WindowsBase reference
         conflicts with WinForms' copy. Harmless: the WPF control is not used. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The web UI and the app catalog ship next to the exe. -->
    <None Include="..\..\ui\**\*" LinkBase="ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\setup\catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The project's license and what this exe bundles (inside "TV Box Setup.exe" too). -->
    <None Include="..\..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Setup mode ("TV Box Setup") runs these: the setup folder without the dev, test and USB-media parts, nor the decoding test's clips (the box checks the driver only). -->
    <None Include="..\..\..\setup\**\*" Exclude="..\..\..\setup\dev\**;..\..\..\setup\test\**;..\..\..\setup\autounattend\**;..\..\..\setup\tools\hwdecode-clips\**"
          LinkBase="setup" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The phone remote's web app (served by PhoneServer, nothing else is), with the UI's fonts. -->
    <None Include="..\..\phone\**\*" LinkBase="phone" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ui\fonts\*.woff2" LinkBase="phone\fonts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- Kestrel for the phone remote (PhoneServer.cs says why not HttpListener). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- setup\VERSION: the kept setup scripts say which release they came with (the update job
       checks it against the release's update.json). Written from Directory.Build.props. -->
  <Target Name="WriteSetupVersion" BeforeTargets="AssignTargetPaths">
    <WriteLinesToFile File="$(IntermediateOutputPath)VERSION" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)VERSION" Link="setup\VERSION" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- The watchdog (..\Watchdog) is built for the .NET Framework that comes with Windows, with
       its own compiler, and ships next to the launcher (also inside the setup exe). It carries the
       release version too (a generated Version.cs): a box checks it before installing it. -->
  <PropertyGroup>
    <WatchdogSource>..\Watchdog\Watchdog.cs</WatchdogSource>
    <WatchdogVersionFile>$(BaseIntermediateOutputPath)watchdog\Version.cs</WatchdogVersionFile>
    <WatchdogExe>$(BaseIntermediateOutputPath)watchdog\HtpcWatchdog.exe</WatchdogExe>
    <FrameworkCsc>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe</FrameworkCsc>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(WatchdogExe)" Link="HtpcWatchdog.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Rebuilt when the source, this project or the version (Directory.Build.props) changes. -->
  <Target Name="BuildWatchdog" BeforeTargets="BeforeBuild" Inputs="$(WatchdogSource);$(MSBuildProjectFullPath);$(DirectoryBuildPropsPath)" Outputs="$(WatchdogExe)">
    <MakeDir Directories="$(BaseIntermediateOutputPath)watchdog" />
    <WriteLinesToFile File="$(WatchdogVersionFile)" Overwrite="true"
      Lines="[assembly: System.Reflection.AssemblyVersion(&quot;$(Version)&quot;)];[assembly: System.Reflection.AssemblyFileVersion(&quot;$(Version)&quot;)];[assembly: System.Reflection.AssemblyInformationalVersion(&quot;$(Version)&quot;)]" />
    <Exec Command="&quot;$(FrameworkCsc)&quot; /nologo /target:winexe /optimize+ /warnaserror+ /out:&quot;$(WatchdogExe)&quot; &quot;$(WatchdogSource)&quot; &quot;$(WatchdogVersionFile)&quot;" />
  </Target>

</Project>
