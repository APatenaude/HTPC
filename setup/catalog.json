{
  "version": 1,
  "about": "One list drives setup's app picks and the launcher (SPEC: App catalog, App library). default = pre-ticked in first-run setup and a home tile. preset = default button map (SPEC: Controller map). icon = glyph and colour shown until the app's own logo is cached (the launcher takes it from the installed program or the website: AppLogos). desc = one line on the library card. launch = how the launcher starts it (environment variables expanded); websites open in their own Edge app window. Every app opens filling the screen: through its own switch where it has one (args), else launch.fill = the launcher makes its window cover the screen without a frame, and again whenever it stops doing so while in front. install.scope = how the launcher installs it from the TV: machine (through the elevated \\HTPC\\Jobs task) or user (the launcher runs winget without elevation). install.wingetScope = the --scope handed to winget when it differs from install.scope (Kodi ships only a user-scoped installer but writes to Program Files, so it is installed as machine with --scope user). install.elevated = false marks an app that refuses to install elevated (Spotify): setup's Apps step skips it and it is offered only from the library, never in the setup pick list. autostart = what the app sets up to start or run by itself, beyond what runs from its launch.exe folder (found anyway): run (Run/RunOnce value names), startup (Startup-folder file names), tasks (scheduled task names, \\ first for a full path) and services (set to Manual; only these, never others) take * as a wildcard; prefs = key=value lines (in an .ini section when given) set in its own settings file, as the user, so it does not start itself again or update itself in the background (setup/lib/AppAutostart.ps1, launcher AutostartGuard.cs). launch.env = variables it is started with, for the same (Feishin's updater).",
  "apps": [
    {
      "id": "youtube",
      "name": "YouTube",
      "type": "app",
      "default": true,
      "preset": "controller",
      "desc": "YouTube's TV interface, without ads",
      "icon": { "glyph": "youtube", "color": "#FF5B52" },
      "launch": { "exe": "%ProgramFiles%\\VacuumTube\\VacuumTube.exe", "args": "--fullscreen" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": {
        "source": "github",
        "scope": "machine",
        "repo": "shy1132/VacuumTube",
        "asset": "^VacuumTube-x64-Portable\\.zip$",
        "installDir": "VacuumTube",
        "exe": "VacuumTube.exe",
        "allowInbound": [ "%ProgramFiles%\\VacuumTube\\VacuumTube.exe" ],
        "selfUpdate": {
          "removeFiles": [ "resources\\app-update.yml" ],
          "userDirs": [ "%LOCALAPPDATA%\\vacuumtube-updater" ]
        }
      }
    },
    {
      "id": "twitch",
      "name": "Twitch",
      "type": "website",
      "url": "https://www.twitch.tv",
      "default": true,
      "preset": "mouse",
      "desc": "twitch.tv with your Edge extensions",
      "icon": { "glyph": "chat", "color": "#B08CFF" }
    },
    {
      "id": "stremio",
      "name": "Stremio",
      "type": "app",
      "default": true,
      "preset": "mouse",
      "desc": "Movies and shows through add-ons",
      "icon": { "glyph": "film", "color": "#7C8CFF" },
      "launch": { "exe": "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-shell-ng.exe", "args": "--autoupdater-endpoint=http://127.0.0.1:9/", "fill": true },
      "install": { "source": "winget", "scope": "user", "id": "Stremio.Stremio.Beta", "blockInbound": [ "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-runtime.exe" ] }
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "type": "app",
      "default": true,
      "preset": "controller",
      "desc": "Your Jellyfin library, TV layout",
      "icon": { "glyph": "library", "color": "#3DC0F0" },
      "launch": { "exe": "%ProgramFiles%\\Jellyfin\\Jellyfin Media Player\\JellyfinMediaPlayer.exe", "args": "--tv --fullscreen" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": { "source": "winget", "scope": "machine", "id": "Jellyfin.JellyfinMediaPlayer" }
    },
    {
      "id": "moonlight",
      "name": "Moonlight",
      "type": "app",
      "default": true,
      "preset": "controller",
      "desc": "Play games streamed from your PC",
      "icon": { "glyph": "moon", "color": "#F5D16B" },
      "launch": { "exe": "%ProgramFiles%\\Moonlight Game Streaming\\Moonlight.exe", "fill": true },
      "phoneKeys": { "typing": false },
      "install": { "source": "winget", "scope": "machine", "id": "MoonlightGameStreamingProject.Moonlight" }
    },
    {
      "id": "edge",
      "name": "Browser",
      "type": "app",
      "default": true,
      "preset": "mouse",
      "desc": "The web in a full-screen browser",
      "icon": { "glyph": "globe", "color": "#3CCB9A" },
      "launch": {
        "exe": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
        "args": "--user-data-dir=\"%LOCALAPPDATA%\\HTPC\\edge\\browser\" --start-fullscreen --no-first-run --no-default-browser-check --enable-features=WebContentsForceDark https://www.google.com"
      },
      "install": { "source": "builtin" },
      "autostart": { "run": [ "MicrosoftEdgeAutoLaunch_*" ] }
    },
    {
      "id": "kodi",
      "name": "Kodi",
      "type": "app",
      "default": false,
      "preset": "controller",
      "desc": "Media center for files on your network",
      "icon": { "glyph": "play", "color": "#5AB0FF" },
      "launch": { "exe": "%ProgramFiles%\\Kodi\\kodi.exe", "args": "-fs" },
      "install": { "source": "winget", "scope": "machine", "wingetScope": "user", "id": "XBMCFoundation.Kodi" }
    },
    {
      "id": "vlc",
      "name": "VLC",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "desc": "Plays almost any video or audio file",
      "icon": { "glyph": "play", "color": "#FF8A1F" },
      "launch": { "exe": "%ProgramFiles%\\VideoLAN\\VLC\\vlc.exe", "args": "--fullscreen --no-video-title-show --no-qt-video-autoresize", "fill": true },
      "install": {
        "source": "winget", "scope": "machine", "id": "VideoLAN.VLC",
        "firstRun": [ { "file": "%APPDATA%\\vlc\\vlcrc", "text": "[qt]\nqt-privacy-ask=0\nqt-updates-notif=0\n" } ]
      }
    },
    {
      "id": "plex",
      "name": "Plex HTPC",
      "type": "app",
      "default": false,
      "preset": "controller",
      "desc": "Plex's app made for TVs",
      "icon": { "glyph": "play", "color": "#F5B82E" },
      "launch": { "exe": "%ProgramFiles%\\Plex\\Plex HTPC\\Plex HTPC.exe", "fill": true },
      "install": { "source": "winget", "scope": "machine", "id": "Plex.PlexHTPC" },
      "autostart": {
        "prefs": [ { "file": "%LOCALAPPDATA%\\Plex HTPC\\plex.ini", "section": "debug", "set": { "disableUpdater": "true" } } ]
      }
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "desc": "Music streaming",
      "icon": { "glyph": "music", "color": "#1ED760" },
      "launch": { "exe": "%APPDATA%\\Spotify\\Spotify.exe", "fill": true },
      "install": { "source": "winget", "scope": "user", "elevated": false, "id": "Spotify.Spotify" },
      "autostart": {
        "run": [ "Spotify" ],
        "prefs": [ { "file": "%APPDATA%\\Spotify\\prefs", "set": { "app.autostart-configured": "true", "app.autostart-mode": "\"off\"" } } ]
      }
    },
    {
      "id": "feishin",
      "name": "Feishin",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "desc": "Music from your Navidrome server",
      "icon": { "glyph": "music", "color": "#FF7AB6" },
      "launch": { "exe": "%LOCALAPPDATA%\\Programs\\feishin\\Feishin.exe", "fill": true, "env": { "DISABLE_AUTO_UPDATES": "1" } },
      "install": { "source": "winget", "scope": "user", "id": "jeffvli.Feishin" }
    },
    { "id": "netflix", "name": "Netflix", "type": "website", "url": "https://www.netflix.com", "default": false, "preset": "mouse", "desc": "Films and series", "icon": { "glyph": "play", "color": "#FF4B55" } },
