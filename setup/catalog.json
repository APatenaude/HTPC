{
  "version": 1,
  "about": "One list drives setup's app picks and the launcher (SPEC: App catalog). default = pre-ticked in first-run setup and a home tile. preset = default button map (SPEC: Controller map). icon = stand-in glyph and colour from the design until real logos. launch = how the launcher starts it (environment variables expanded); websites open in their own Edge app window.",
  "apps": [
    {
      "id": "youtube",
      "name": "YouTube",
      "type": "app",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "youtube", "color": "#FF5B52" },
      "launch": { "exe": "%ProgramFiles%\\VacuumTube\\VacuumTube.exe", "args": "--fullscreen" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": {
        "source": "github",
        "repo": "shy1132/VacuumTube",
        "asset": "^VacuumTube-x64-Portable\\.zip$",
        "installDir": "VacuumTube",
        "exe": "VacuumTube.exe",
        "allowInbound": [ "%ProgramFiles%\\VacuumTube\\VacuumTube.exe" ]
      }
    },
    {
      "id": "twitch",
      "name": "Twitch",
      "type": "website",
      "url": "https://www.twitch.tv",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "chat", "color": "#B08CFF" }
    },
    {
      "id": "stremio",
      "name": "Stremio",
      "type": "app",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "film", "color": "#7C8CFF" },
      "launch": { "exe": "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-shell-ng.exe", "fill": true },
      "install": { "source": "winget", "id": "Stremio.Stremio.Beta", "blockInbound": [ "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-runtime.exe" ] }
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "type": "app",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "library", "color": "#3DC0F0" },
      "launch": { "exe": "%ProgramFiles%\\Jellyfin\\Jellyfin Media Player\\JellyfinMediaPlayer.exe", "args": "--tv" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": { "source": "winget", "id": "Jellyfin.JellyfinMediaPlayer" }
    },
    {
      "id": "moonlight",
      "name": "Moonlight",
      "type": "app",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "moon", "color": "#F5D16B" },
      "launch": { "exe": "%ProgramFiles%\\Moonlight Game Streaming\\Moonlight.exe" },
      "phoneKeys": { "typing": false },
      "install": { "source": "winget", "id": "MoonlightGameStreamingProject.Moonlight" }
    },
    {
      "id": "edge",
      "name": "Edge",
      "type": "app",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "globe", "color": "#3CCB9A" },
      "launch": {
        "exe": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
        "args": "--user-data-dir=\"%LOCALAPPDATA%\\HTPC\\edge\\browser\" --start-fullscreen --no-first-run --no-default-browser-check"
      },
      "install": { "source": "builtin" }
    },
    {
      "id": "kodi",
      "name": "Kodi",
      "type": "app",
      "default": false,
      "preset": "controller",
      "icon": { "glyph": "play", "color": "#5AB0FF" },
      "launch": { "exe": "%ProgramFiles%\\Kodi\\kodi.exe" },
      "install": { "source": "winget", "id": "XBMCFoundation.Kodi" }
    },
    {
      "id": "vlc",
      "name": "VLC",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "play", "color": "#FF8A1F" },
      "launch": { "exe": "%ProgramFiles%\\VideoLAN\\VLC\\vlc.exe" },
      "install": {
        "source": "winget", "id": "VideoLAN.VLC",
        "firstRun": [ { "file": "%APPDATA%\\vlc\\vlcrc", "text": "[qt]\nqt-privacy-ask=0\nqt-updates-notif=0\n" } ]
      }
    },
    {
      "id": "plex",
      "name": "Plex HTPC",
      "type": "app",
      "default": false,
      "preset": "controller",
      "icon": { "glyph": "play", "color": "#F5B82E" },
      "launch": { "exe": "%ProgramFiles%\\Plex\\Plex HTPC\\Plex HTPC.exe" },
      "install": { "source": "winget", "id": "Plex.PlexHTPC" }
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "music", "color": "#1ED760" },
      "install": { "source": "winget", "id": "Spotify.Spotify", "asUser": true }
    },
    {
      "id": "feishin",
      "name": "Feishin",
      "type": "app",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "music", "color": "#FF7AB6" },
      "install": { "source": "winget", "id": "jeffvli.Feishin" }
    },
    { "id": "netflix", "name": "Netflix", "type": "website", "url": "https://www.netflix.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#FF4B55" } },
    { "id": "disneyplus", "name": "Disney+", "type": "website", "url": "https://www.disneyplus.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#4D8DFF" } },
    { "id": "primevideo", "name": "Prime Video", "type": "website", "url": "https://www.primevideo.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#2BB0F5" } },
    { "id": "crunchyroll", "name": "Crunchyroll", "type": "website", "url": "https://www.crunchyroll.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#FF8A2B" } },
    { "id": "hbomax", "name": "HBO Max", "type": "website", "url": "https://play.hbomax.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#8A7BFF" } },
    { "id": "appletv", "name": "Apple TV+", "type": "website", "url": "https://tv.apple.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#D9D8D4" } },
    { "id": "paramountplus", "name": "Paramount+", "type": "website", "url": "https://www.paramountplus.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#3D8BFF" } },
    { "id": "tubi", "name": "Tubi", "type": "website", "url": "https://tubitv.com", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#FFD43B" } },
    { "id": "plutotv", "name": "Pluto TV", "type": "website", "url": "https://pluto.tv", "default": false, "preset": "mouse", "icon": { "glyph": "tv", "color": "#F5E642" } },
    { "id": "kick", "name": "Kick", "type": "website", "url": "https://kick.com", "default": false, "preset": "mouse", "icon": { "glyph": "chat", "color": "#53FC18" } },
    { "id": "crave", "name": "Crave", "type": "website", "url": "https://www.crave.ca", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#3FA9F5" } },
    { "id": "cbcgem", "name": "CBC Gem", "type": "website", "url": "https://gem.cbc.ca", "default": false, "preset": "mouse", "icon": { "glyph": "play", "color": "#FF4B4B" } }
  ]
}
