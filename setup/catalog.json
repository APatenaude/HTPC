    { "id": "appletv", "name": "Apple TV+", "type": "website", "url": "https://tv.apple.com", "default": false, "preset": "mouse", "desc": "Apple's originals", "icon": { "glyph": "play", "color": "#D9D8D4" } },
    { "id": "paramountplus", "name": "Paramount+", "type": "website", "url": "https://www.paramountplus.com", "default": false, "preset": "mouse", "desc": "Paramount films and shows", "icon": { "glyph": "play", "color": "#3D8BFF" } },
    { "id": "tubi", "name": "Tubi", "type": "website", "url": "https://tubitv.com", "default": false, "preset": "mouse", "desc": "Free films and TV with ads", "icon": { "glyph": "play", "color": "#FFD43B" } },
    { "id": "plutotv", "name": "Pluto TV", "type": "website", "url": "https://pluto.tv", "default": false, "preset": "mouse", "desc": "Free live channels", "icon": { "glyph": "tv", "color": "#F5E642" } },
