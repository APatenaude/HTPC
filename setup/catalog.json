{
  "version": 1,
  "about": "The fields and their rules: docs/CATALOG.md.",
  "categories": [
    { "id": "movies", "name": "Movies & shows" },
    { "id": "canada", "name": "Canadian TV" },
    { "id": "sports", "name": "Sports" },
    { "id": "music", "name": "Music" },
    { "id": "games", "name": "Games" },
    { "id": "media", "name": "Your media & tools" }
  ],
  "apps": [
    {
      "id": "youtube",
      "name": "YouTube",
      "logoUrl": "https://www.gstatic.com/youtube/img/branding/favicon/favicon_192x192.png",
      "type": "app",
      "category": "movies",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "youtube", "color": "#FF5B52" },
      "launch": { "exe": "%ProgramFiles%\\VacuumTube\\VacuumTube.exe", "args": "--fullscreen" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": {
        "source": "github",
        "scope": "machine",
        "repo": "shy1132/VacuumTube",
        "asset": "^VacuumTube-x64-Portable\\.zip$",
        "installDir": "VacuumTube",
        "exe": "VacuumTube.exe",
        "allowInbound": [ "%ProgramFiles%\\VacuumTube\\VacuumTube.exe" ],
        "selfUpdate": {
          "removeFiles": [ "resources\\app-update.yml" ],
          "userDirs": [ "%LOCALAPPDATA%\\vacuumtube-updater" ]
        }
      }
    },
    {
      "id": "twitch",
      "name": "Twitch",
      "type": "website",
      "category": "movies",
      "url": "https://www.twitch.tv",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "chat", "color": "#B08CFF" }
    },
    {
      "id": "stremio",
      "name": "Stremio",
      "type": "app",
      "category": "movies",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "film", "color": "#7C8CFF" },
      "launch": { "exe": "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-shell-ng.exe", "args": "--autoupdater-endpoint=http://127.0.0.1:9/", "fill": true, "quitWhenWindowless": 60 },
      "install": { "source": "winget", "scope": "user", "id": "Stremio.Stremio.Beta", "blockInbound": [ "%LOCALAPPDATA%\\Programs\\Stremio\\stremio-runtime.exe" ] }
    },
    {
      "id": "jellyfin",
      "name": "Jellyfin",
      "type": "app",
      "category": "media",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "library", "color": "#3DC0F0" },
      "launch": { "exe": "%ProgramFiles%\\Jellyfin\\Jellyfin Media Player\\JellyfinMediaPlayer.exe", "args": "--tv --fullscreen" },
      "phoneKeys": { "back": "esc", "backspace": "afterTyping" },
      "install": { "source": "winget", "scope": "machine", "id": "Jellyfin.JellyfinMediaPlayer" }
    },
    {
      "id": "moonlight",
      "name": "Moonlight",
      "ownController": true,
      "type": "app",
      "category": "games",
      "default": true,
      "preset": "controller",
      "icon": { "glyph": "moon", "color": "#F5D16B" },
      "launch": { "exe": "%ProgramFiles%\\Moonlight Game Streaming\\Moonlight.exe", "fill": true },
      "phoneKeys": { "typing": false },
      "menuKeys": { "select": "key:Shift+Tab", "whileClass": "Qt*QWindow*" },
      "install": { "source": "winget", "scope": "machine", "id": "MoonlightGameStreamingProject.Moonlight" }
    },
    {
      "id": "edge",
      "name": "Browser",
      "type": "app",
      "category": "media",
      "default": true,
      "preset": "mouse",
      "icon": { "glyph": "globe", "color": "#3CCB9A" },
      "launch": {
        "exe": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe",
        "args": "--user-data-dir=\"%LOCALAPPDATA%\\HTPC\\edge\\browser\" --start-maximized --no-first-run --no-default-browser-check --enable-features=WebContentsForceDark --disk-cache-size=104857600 https://www.google.com"
      },
      "install": { "source": "builtin" },
      "autostart": { "run": [ "MicrosoftEdgeAutoLaunch_*" ] }
    },
    {
      "id": "kodi",
      "name": "Kodi",
      "type": "app",
      "category": "media",
      "default": false,
      "preset": "controller",
      "icon": { "glyph": "play", "color": "#5AB0FF" },
      "launch": { "exe": "%ProgramFiles%\\Kodi\\kodi.exe", "args": "-fs" },
      "install": { "source": "winget", "scope": "machine", "wingetScope": "user", "id": "XBMCFoundation.Kodi" }
    },
    {
      "id": "vlc",
      "name": "VLC",
      "type": "app",
      "category": "media",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "play", "color": "#FF8A1F" },
      "launch": { "exe": "%ProgramFiles%\\VideoLAN\\VLC\\vlc.exe", "args": "--fullscreen --no-video-title-show --no-qt-video-autoresize", "fill": true },
      "install": {
        "source": "winget", "scope": "machine", "id": "VideoLAN.VLC",
        "firstRun": [ { "file": "%APPDATA%\\vlc\\vlcrc", "text": "[qt]\nqt-privacy-ask=0\nqt-updates-notif=0\n" } ]
      }
    },
    {
      "id": "plex",
      "name": "Plex HTPC",
      "type": "app",
      "category": "media",
      "default": false,
      "preset": "keyboard",
      "ownKeyboard": true,
      "icon": { "glyph": "play", "color": "#F5B82E" },
      "launch": { "exe": "%ProgramFiles%\\Plex\\Plex HTPC\\Plex HTPC.exe", "fill": true },
      "install": { "source": "winget", "scope": "machine", "id": "Plex.PlexHTPC" },
      "autostart": {
        "prefs": [ { "file": "%LOCALAPPDATA%\\Plex HTPC\\plex.ini", "section": "debug", "set": { "disableUpdater": "true" } } ]
      }
    },
    {
      "id": "spotify",
      "name": "Spotify",
      "type": "app",
      "category": "music",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "music", "color": "#1ED760" },
      "launch": { "exe": "%APPDATA%\\Spotify\\Spotify.exe", "fill": true },
      "install": { "source": "winget", "scope": "user", "elevated": false, "id": "Spotify.Spotify" },
      "autostart": {
        "run": [ "Spotify" ],
        "prefs": [ { "file": "%APPDATA%\\Spotify\\prefs", "set": { "app.autostart-configured": "true", "app.autostart-mode": "\"off\"" } } ]
      }
    },
    {
      "id": "feishin",
      "name": "Feishin",
      "type": "app",
      "category": "music",
      "default": false,
      "preset": "mouse",
      "icon": { "glyph": "music", "color": "#FF7AB6" },
      "launch": { "exe": "%LOCALAPPDATA%\\Programs\\feishin\\Feishin.exe", "fill": true, "cropTop": 30, "env": { "DISABLE_AUTO_UPDATES": "1" } },
      "install": { "source": "winget", "scope": "user", "id": "jeffvli.Feishin" }
    },
    {
      "id": "playnite",
      "name": "Playnite",
      "type": "app",
      "category": "games",
      "default": false,
      "preset": "controller",
      "icon": { "glyph": "controller", "color": "#B08CFF" },
      "launch": { "exe": "%LOCALAPPDATA%\\Playnite\\Playnite.FullscreenApp.exe", "args": "--hidesplashscreen", "fill": true, "clearBeforeStart": [ "%APPDATA%\\Playnite\\safestart.flag" ] },
      "install": { "source": "winget", "scope": "user", "id": "Playnite.Playnite" },
      "autostart": { "startup": [ "Playnite.lnk" ] }
    },
    {
      "id": "retroarch",
      "name": "RetroArch",
      "type": "app",
      "category": "games",
      "default": false,
      "preset": "controller",
      "icon": { "glyph": "controller", "color": "#5AB0FF" },
      "launch": { "exe": "C:\\RetroArch-Win64\\retroarch.exe", "args": "--fullscreen" },
      "install": { "source": "winget", "scope": "machine", "id": "Libretro.RetroArch" }
    },
