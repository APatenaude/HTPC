    { "id": "crunchyroll", "name": "Crunchyroll", "type": "website", "url": "https://www.crunchyroll.com", "default": false, "preset": "mouse", "desc": "Anime, subbed and dubbed", "icon": { "glyph": "play", "color": "#FF8A2B" } },
