<Project>

  <!--
    The TV box's one version number. Everything a release ships carries it: the launcher (and so
    "TV Box Setup.exe", the same file), the watchdog (its build generates an AssemblyInfo from
    it), the setup scripts (a VERSION file in setup.zip) and the release's update.json.
    launcher\dev\New-Release.ps1 changes it; the release workflow refuses a tag that differs.
    Plain numeric SemVer (major.minor.patch): boxes compare the numbers, so 0.10.0 > 0.9.0.
  -->
  <PropertyGroup>
    <Version>1.0.9</Version>
    <!--
      The oldest launcher that may update to this release by itself; older boxes are told to run
      TV Box Setup again (launcher\dev\Build-Release.ps1 writes it into update.json). 1.0.0: the
      0.1.x boxes' own update code lacks 1.0's protections, and 1.0 brings setup steps an update
      cannot apply (drivers, the phone certificate in the machine store, the sign-in colour).
      1.0.5: the update jobs of 1.0.0 to 1.0.4 stop at their first step (a keep-awake flag PowerShell
      passed as a negative number), so those boxes cannot update themselves at all.
    -->
    <UpdateMinimumFrom>1.0.5</UpdateMinimumFrom>
  </PropertyGroup>

</Project>
